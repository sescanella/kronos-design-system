---
/**
 * CTASection — reference component of the Kronos design system for the Astro stack (since 2026-11-20).
 *
 * The block that closes every page of the site: mono label → sentence-case headline (k-h2) → lede → the two
 * buttons → the hero's centreline → one line of company data. It is built only from the standard's kit
 * (kronos-web src/styles/estandar.css: k-sec, k-head, k-h2, k-lede) and the global classes (TechLabel,
 * BlueprintGrid, .btn-kronos-*): copy the structure, not CSS.
 *
 * Motion: none of its own. The section appears with pattern 3 of design/animations.md (its hairline draws,
 * the opening rises, the content fades in as one block), handled by the site's motion module. No WebGL
 * background, no per-line headline reveal, no looping glow on the button, and no `snap-section` — scroll
 * snapping belongs to the home only.
 *
 * The site's own copy (kronos-web src/components/CTASection.astro) may change copy and links, never this
 * structure or its rules (DESIGN.md, design/anti-patterns.md).
 */
import TechLabel from './TechLabel.astro';
import BlueprintGrid from './BlueprintGrid.astro';

interface Props {
  /** Headline, sentence case; the default works on any page. */
  title?: string;
  lede?: string;
}

const {
  title = 'Cotiza tu proyecto de piping o revestimiento',
  lede = 'Envíanos los planos o la especificación y preparamos la cotización. Fabricamos spools de 6″ a 42″ en nuestra planta de Lampa.',
} = Astro.props;
---

<section class="k-sec cta" aria-label="Contacto">
  <BlueprintGrid />
  <div class="k-sec__inner">
    <header class="k-head">
      <TechLabel label="CONTACTO" />
      <h2 class="k-h2">{title}</h2>
      <p class="k-lede">{lede}</p>
    </header>

    <div class="cta__actions">
      <a href="/contacto" class="btn-kronos-primary">
        <span class="btn-kronos-primary__label">SOLICITAR COTIZACIÓN</span>
        <span class="btn-kronos-primary__arrow" aria-hidden="true">→</span>
      </a>
      <a href="/contacto/matias-espinoza" class="btn-kronos-outline">
        <span class="btn-kronos-outline__fill" aria-hidden="true"></span>
        <span class="btn-kronos-outline__label">AGENDAR VISITA</span>
      </a>
    </div>

    <!-- The hero's centreline (chain line) closes the page -->
    <span class="cta__axis" aria-hidden="true"></span>
    <p class="cta__foot">
      <span>Kronos Mining · Lampa, Chile</span>
      <span>ISO 9001 / 14001 / 45001</span>
      <span>Desde 2016</span>
    </p>
  </div>
</section>

<style>
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cta__axis {
    display: block;
    height: 2px;
    margin-top: clamp(4rem, 8vw, 7rem);
    background: repeating-linear-gradient(
      90deg,
      var(--color-accent) 0 14px,
      transparent 14px 18px,
      var(--color-accent) 18px 20px,
      transparent 20px 24px
    );
  }
  .cta__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 2rem;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.62);
  }
  @media (min-width: 48rem) {
    .cta__actions {
      flex-direction: row;
    }
    .cta__foot {
      justify-content: space-between;
    }
  }
</style>
